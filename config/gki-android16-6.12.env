# ================= 一加 15T (Android 16 / 6.12 内核) =================
KERNEL_SOURCE=https://android.googlesource.com/kernel/common
KERNEL_SOURCE_BRANCH=android16-6.12
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image

# 编译工具链
USE_LLVM=true

# Root 驱动方案 (SukiSU) 与 SuSFS 强隐藏
KSU_VARIANT=sukisu
ENABLE_SUSFS=true

# 开启 TCP BBR 网络加速 (单行空格分隔，防止 Shell 读取换行报错)
EXTRA_DEFCONFIG="CONFIG_TCP_CONG_BBR=y CONFIG_NET_SCH_FQ=y CONFIG_DEFAULT_TCP_CONG=\"bbr\""
